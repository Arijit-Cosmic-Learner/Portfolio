# Copy to .env.local and fill in.

# Admin (visit counter) -- choose a strong password and a long random secret
ADMIN_PASSWORD=change-me
SESSION_SECRET=long-random-string

# Visit counter storage (free Upstash Redis). Without these, counts live in memory (dev only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Contact form email via Resend
RESEND_API_KEY=
CONTACT_TO_EMAIL=mitra.ari99@gmail.com
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# GitHub section (token: classic PAT with read:user scope, or fine-grained read-only)
GITHUB_USERNAME=
GITHUB_TOKEN=
